{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"Many times they have afflicted me from my youth up.","poem":1},{"text":"Let Israel now say:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"many times they have afflicted me from my youth up,","poem":1},{"text":"yet they have not prevailed against me.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The plowers plowed on my back.","poem":1},{"text":"They made their furrows long.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD is righteous.","poem":1},{"text":"He has cut apart the cords of the wicked.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Let them be disappointed and turned backward,","poem":1},{"text":"all those who hate Zion.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Let them be as the grass on the housetops,","poem":1},{"text":"which withers before it grows up,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"with which the reaper doesn’t fill his hand,","poem":1},{"text":"nor he who binds sheaves, his bosom.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neither do those who go by say,","poem":1},{"text":"“The blessing of the LORD be on you.","poem":2},{"lineBreak":true},{"text":"We bless you in the LORD’s name.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}