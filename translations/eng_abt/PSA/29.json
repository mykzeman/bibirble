{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSA","translationId":"eng_abt","name":"Psalms","commonName":"Psalms","title":"THE PSALMS","order":19,"numberOfChapters":150,"sha256":"6f1e14e58a2bd60026d935a29789fc0f57abb70894fb53fa7776d8646c5d2f19","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Ascribe unto Jehovah, O ye sons of the mighty,","poem":1},{"lineBreak":true},{"text":"Ascribe unto Jehovah glory and strength.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ascribe unto Jehovah the glory due unto his name;","poem":1},{"lineBreak":true},{"text":"Worship Jehovah in holy array.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"The voice of Jehovah is upon the waters:","poem":1},{"lineBreak":true},{"text":"The God of glory thundereth,","poem":1},{"lineBreak":true},{"text":"Even Jehovah upon many waters.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The voice of Jehovah is powerful;","poem":1},{"lineBreak":true},{"text":"The voice of Jehovah is full of majesty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The voice of Jehovah breaketh the cedars;","poem":1},{"lineBreak":true},{"text":"Yea, Jehovah breaketh in pieces the cedars of Lebanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He maketh them also to skip like a calf;","poem":1},{"lineBreak":true},{"text":"Lebanon and Sirion like a young wild ox.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The voice of Jehovah cleaveth the flames of fire.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The voice of Jehovah shaketh the wilderness;","poem":1},{"lineBreak":true},{"text":"Jehovah shaketh the wilderness of Kadesh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The voice of Jehovah maketh the hinds to calve,","poem":1},{"lineBreak":true},{"text":"And strippeth the forests bare:","poem":1},{"lineBreak":true},{"text":"And in his temple everything saith, Glory.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jehovah sat as King at the Flood;","poem":1},{"lineBreak":true},{"text":"Yea, Jehovah sitteth as King forever.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jehovah will give strength unto his people;","poem":1},{"lineBreak":true},{"text":"Jehovah will bless his people with peace.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}