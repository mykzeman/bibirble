{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSA","translationId":"eng_abt","name":"Psalms","commonName":"Psalms","title":"THE PSALMS","order":19,"numberOfChapters":150,"sha256":"6f1e14e58a2bd60026d935a29789fc0f57abb70894fb53fa7776d8646c5d2f19","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents; of Solomon."]},{"type":"verse","number":1,"content":[{"text":"Except Jehovah build the house,","poem":1},{"lineBreak":true},{"text":"They labor in vain that build it:","poem":1},{"lineBreak":true},{"text":"Except Jehovah keep the city,","poem":1},{"lineBreak":true},{"text":"The watchman waketh but in vain.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"It is vain for you to rise up early,","poem":1},{"lineBreak":true},{"text":"To take rest late,","poem":1},{"lineBreak":true},{"text":"To eat the bread of toil;","poem":1},{"lineBreak":true},{"text":"For so he giveth unto his beloved sleep.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lo, children are a heritage of Jehovah;","poem":1},{"lineBreak":true},{"text":"And the fruit of the womb is his reward.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"As arrows in the hand of a mighty man,","poem":1},{"lineBreak":true},{"text":"So are the children of youth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Happy is the man that hath his quiver full of them:","poem":1},{"lineBreak":true},{"text":"They shall not be put to shame,","poem":1},{"lineBreak":true},{"text":"When they speak with their enemies in the gate.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}