{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSA","translationId":"eng_abt","name":"Psalms","commonName":"Psalms","title":"THE PSALMS","order":19,"numberOfChapters":150,"sha256":"6f1e14e58a2bd60026d935a29789fc0f57abb70894fb53fa7776d8646c5d2f19","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Jehovah saith unto my Lord, Sit thou at my right hand,","poem":1},{"lineBreak":true},{"text":"Until I make thine enemies thy footstool.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jehovah will send forth the rod of thy strength out of Zion:","poem":1},{"lineBreak":true},{"text":"Rule thou in the midst of thine enemies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy people offer themselves willingly","poem":1},{"lineBreak":true},{"text":"In the day of thy power, in holy array:","poem":1},{"lineBreak":true},{"text":"Out of the womb of the morning","poem":1},{"lineBreak":true},{"text":"Thou hast the dew of thy youth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jehovah hath sworn, and will not repent:","poem":1},{"lineBreak":true},{"text":"Thou art a priest forever","poem":1},{"lineBreak":true},{"text":"After the order of Melchizedek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord at thy right hand","poem":1},{"lineBreak":true},{"text":"Will strike through kings in the day of his wrath.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He will judge among the nations,","poem":1},{"lineBreak":true},{"text":"He will fill the places with dead bodies;","poem":1},{"lineBreak":true},{"text":"He will strike through the head in many countries.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He will drink of the brook in the way:","poem":1},{"lineBreak":true},{"text":"Therefore will he lift up the head.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}