"content":[{"lineBreak":true},{"text":"God is gone up with a shout,","poem":1},{"lineBreak":true},{"text":"Jehovah with the sound of a trumpet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sing praises to God, sing praises:","poem":1},{"lineBreak":true},{"text":"Sing praises unto our King, sing praises.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For God is the King of all the earth:","poem":1},{"lineBreak":true},{"text":"Sing ye praises with understanding.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God reigneth over the nations:","poem":1},{"lineBreak":true},{"text":"God sitteth upon his holy throne.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The princes of the peoples are gathered together","poem":1},{"lineBreak":true},{"text":"To be the people of the God of Abraham;","poem":1},{"lineBreak":true},{"text":"For the shields of the earth belong unto God:","poem":1},{"lineBreak":true},{"text":"He is greatly exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}