{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"PSA","translationId":"eng_abt","name":"Psalms","commonName":"Psalms","title":"THE PSALMS","order":19,"numberOfChapters":150,"sha256":"6f1e14e58a2bd60026d935a29789fc0f57abb70894fb53fa7776d8646c5d2f19","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician; on stringed instruments. A Psalm of Asaph, a Song."]},{"type":"verse","number":1,"content":[{"text":"In Judah is God known:","poem":1},{"lineBreak":true},{"text":"His name is great in Israel.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"In Salem also is his tabernacle,","poem":1},{"lineBreak":true},{"text":"And his dwelling place in Zion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"There he brake the arrows of the bow;","poem":1},{"lineBreak":true},{"text":"The shield, and the sword, and the battle. Selah","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Glorious art thou and excellent,","poem":1},{"lineBreak":true},{"text":"From the mountains of prey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The stouthearted are made a spoil,","poem":1},{"lineBreak":true},{"text":"They have slept their sleep;","poem":1},{"lineBreak":true},{"text":"And none of the men of might have found their hands.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"At thy rebuke, O God of Jacob,","poem":1},{"lineBreak":true},{"text":"Both chariot and horse are cast into a dead sleep.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thou, even thou, art to be feared;","poem":1},{"lineBreak":true},{"text":"And who may stand in thy sight when once thou art angry?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Thou didst cause sentence to be heard from heaven;","poem":1},{"lineBreak":true},{"text":"The earth feared, and was still,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"When God arose to judgment,","poem":1},{"lineBreak":true},{"text":"To save all the meek of the earth. Selah","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Surely the wrath of man shall praise thee:","poem":1},{"lineBreak":true},{"text":"The residue of wrath shalt thou gird upon thee.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vow, and pay unto Jehovah your God:","poem":1},{"lineBreak":true},{"text":"Let all that are round about him bring presents unto him that ought to be feared.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"He will cut off the spirit of princes:","poem":1},{"lineBreak":true},{"text":"He is terrible to the kings of the earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}