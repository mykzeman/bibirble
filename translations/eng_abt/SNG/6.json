{"translation":{"id":"eng_abt","name":"American Standard Version Byzantine Text","website":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engasvbt","licenseNotes":null,"shortName":"ASVBT","englishName":"ASV Byzantine Text","language":"eng","textDirection":"ltr","sha256":"52505ccc9768bd034f1e3da944fcf3382ccae7545f65fc498e31917a77097655","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_abt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":18,"totalNumberOfApocryphalChapters":216,"totalNumberOfApocryphalVerses":6744},"book":{"id":"SNG","translationId":"eng_abt","name":"Song of Solomon","commonName":"Song of Songs","title":"THE SONG OF SOLOMON","order":22,"numberOfChapters":8,"sha256":"07faf6051cb85bae763054af14c2beea806e8b2e4a20281688acc39f88600a3a","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_abt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/eng_abt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Whither is thy beloved gone,","poem":1},{"lineBreak":true},{"text":"O thou fairest among women?","poem":1},{"lineBreak":true},{"text":"Whither hath thy beloved turned him,","poem":1},{"lineBreak":true},{"text":"That we may seek him with thee?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"My beloved is gone down to his garden,","poem":1},{"lineBreak":true},{"text":"To the beds of spices,","poem":1},{"lineBreak":true},{"text":"To feed in the gardens, and to gather lilies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I am my beloved’s, and my beloved is mine:","poem":1},{"lineBreak":true},{"text":"He feedeth his flock among the lilies.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Thou art fair, O my love, as Tirzah,","poem":1},{"lineBreak":true},{"text":"Comely as Jerusalem,","poem":1},{"lineBreak":true},{"text":"Terrible as an army with banners.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Turn away thine eyes from me,","poem":1},{"lineBreak":true},{"text":"For they have overcome me.","poem":1},{"lineBreak":true},{"text":"Thy hair is as a flock of goats,","poem":1},{"lineBreak":true},{"text":"That lie along the side of Gilead.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thy teeth are like a flock of ewes,","poem":1},{"lineBreak":true},{"text":"Which are come up from the washing;","poem":1},{"lineBreak":true},{"text":"Whereof every one hath twins,","poem":1},{"lineBreak":true},{"text":"And none is bereaved among them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Thy temples are like a piece of a pomegranate","poem":1},{"lineBreak":true},{"text":"Behind thy veil.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"There are threescore queens, and fourscore concubines,","poem":1},{"lineBreak":true},{"text":"And virgins without number.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"My dove, my undefiled, is but one;","poem":1},{"lineBreak":true},{"text":"She is the only one of her mother;","poem":1},{"lineBreak":true},{"text":"She is the choice one of her that bare her.","poem":1},{"lineBreak":true},{"text":"The daughters saw her, and called her blessed;","poem":1},{"lineBreak":true},{"text":"Yea, the queens and the concubines, and they praised her.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Who is she that looketh forth as the morning,","poem":1},{"lineBreak":true},{"text":"Fair as the moon,","poem":1},{"lineBreak":true},{"text":"Clear as the sun,","poem":1},{"lineBreak":true},{"text":"Terrible as an army with banners?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"I went down into the garden of nuts,","poem":1},{"lineBreak":true},{"text":"To see the green plants of the valley,","poem":1},{"lineBreak":true},{"text":"To see whether the vine budded,","poem":1},{"lineBreak":true},{"text":"And the pomegranates were in flower.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Before I was aware, my soul set me","poem":1},{"lineBreak":true},{"text":"Among the chariots of my princely people.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Return, return, O Shulammite;","poem":1},{"lineBreak":true},{"text":"Return, return, that we may look upon thee.","poem":1},{"lineBreak":true},{"text":"Why will ye look upon the Shulammite,","poem":1},{"lineBreak":true},{"text":"As upon the dance of Mahanaim?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_abt/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_abt/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_abt/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}