// Windows resources for Bibirble.exe.
//
// Every Bible version (bibles/<id>.json.gz) is compiled into the exe so the
// game runs as a single file (see src/EmbeddedData.cpp). A bibles/<id>.json.gz
// next to the exe still takes priority over the embedded copy. The list is
// generated by tools/sort.py.
#include "bibles/bibles.rc"

// Story Mode's map, embedded the same way (a story_map.json next to the exe
// takes priority).
STORY_MAP_JSON RCDATA "story_map.json"
// The Story Mode map picture the levels are pinned on.
STORY_MAP_PNG RCDATA "data/story_map.png"

// English word list for Story Mode's fill-in-the-blank puzzles (the
// public-domain ENABLE list).
WORD_LIST_TXT RCDATA "data/words.txt"

// App icon (same artwork as Bibirble-web's icons/). Explorer shows the icon
// group whose name sorts first, so "appicon" also beats wx.rc's wxICON_AAA;
// BibirbleWindow loads it by this name for the title bar and taskbar.
appicon ICON "icons/bibirble.ico"

// MinGW builds: pull in wxWidgets' standard resources, including the manifest
// that turns on modern (Common Controls v6) widgets and DPI awareness. MSVC's
// linker writes its own manifest, so including wx.rc there would clash.
#ifdef __GNUC__
#include "wx/msw/wx.rc"
#endif
